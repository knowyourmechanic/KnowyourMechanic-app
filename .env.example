# ---- Web/mobile client (Vite) -------------------------------------------
# Optional: the app defaults to the production Supabase project. Override to
# point a build at another project. The publishable key is public by design.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# ---- Supabase Edge Function secrets ------------------------------------
# Set with `supabase secrets set NAME=value` — NEVER in the client or git.
# (SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by Supabase.)
SERVICE_OTP_PEPPER=long-random-string
AUTH_HOOK_SECRET=v1,whsec_xxx            # Supabase Auth "Send SMS" hook secret

# MSG91 (login SMS + service OTP SMS + WhatsApp templates)
MSG91_AUTH_KEY=
MSG91_FLOW_ID=
MSG91_OTP_VAR=otp
MSG91_SERVICE_OTP_TEMPLATE_ID=
MSG91_WHATSAPP_NUMBER=
MSG91_WA_NAMESPACE=
MSG91_WA_OTP_TEMPLATE=
MSG91_WA_INVOICE_TEMPLATE=
MSG91_WA_REENGAGE_TEMPLATE=

# FCM push (service-account JSON, single line)
FCM_SERVICE_ACCOUNT={"client_email":"...","private_key":"...","project_id":"..."}

# Razorpay (garage fee settlement)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Dev only: return the service OTP to the garage for these test numbers.
ALLOW_DEV_OTP=false
TEST_OTP_PHONES=
